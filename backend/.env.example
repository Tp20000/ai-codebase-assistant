# ================================================================
# Backend Environment Variables — AI Codebase Assistant v2.0
# Copy to .env and fill in values before running
# NEVER commit .env to git
# ================================================================

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aiassistant:your_password@localhost:5432/ai_codebase_db
POSTGRES_USER=aiassistant
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=ai_codebase_db

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:your_redis_password@localhost:6379/0
REDIS_PASSWORD=your_redis_password_here

# ── JWT Authentication ───────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048
# Then: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App Settings ─────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your_random_secret_key_min_32_chars
API_V1_PREFIX=/api/v1
VERSION=2.0.0

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Ollama (Local LLM) ───────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=tinyllama
OLLAMA_TIMEOUT=120

# ── ChromaDB (Vector Store) ──────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=ai_assistant

# ── HuggingFace Embeddings ───────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_HOME=./.cache/huggingface
TRANSFORMERS_CACHE=./.cache/huggingface

# ── File Upload ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=.py,.js,.ts,.tsx,.jsx,.java,.go,.rs,.cpp,.c,.h,.cs,.rb,.php,.swift,.kt,.scala,.r,.sql,.sh,.yaml,.yml,.json,.md,.txt,.toml,.ini,.cfg,.env.example

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ── Email Notifications (Optional) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@your-domain.com

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:your_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6379/2