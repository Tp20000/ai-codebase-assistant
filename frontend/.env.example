# ================================================================
# Frontend Environment Variables — AI Codebase Assistant v2.0
# Copy to .env and fill in values
# All VITE_ variables are bundled into the app at build time
# NEVER put secrets here — these are public
# ================================================================

# ── API URLs ─────────────────────────────────────────────────────
# Development (local)
VITE_API_URL=http://localhost:8000

# Production (use /api for same-origin nginx proxy, or full URL for separate backend)
# VITE_API_URL=https://your-backend.railway.app
# VITE_API_URL=/api

# ── WebSocket ────────────────────────────────────────────────────
# Development
VITE_WS_URL=ws://localhost:8000

# Production
# VITE_WS_URL=wss://your-backend.railway.app

# ── App Config ───────────────────────────────────────────────────
VITE_APP_NAME=AI Codebase Assistant
VITE_APP_VERSION=2.0.0

# ── Feature Flags ───────────────────────────────────────────────
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_MOCK_API=false