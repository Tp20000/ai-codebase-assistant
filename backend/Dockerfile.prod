# ================================================================
# Production Dockerfile — AI Codebase Assistant Backend
# ================================================================

FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Production image ─────────────────────────────────────────────
FROM python:3.11-slim AS production

LABEL maintainer="AI Codebase Assistant v2.0"

RUN groupadd -r appuser && useradd -r -g appuser -s /sbin/nologin appuser

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq5 curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY . /app/

RUN mkdir -p /app/uploads /app/chroma_data /app/logs && \
    chown -R appuser:appuser /app

USER appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    ENVIRONMENT=production \
    UPLOAD_DIR=/app/uploads \
    CHROMA_PERSIST_DIRECTORY=/app/chroma_data \
    PORT=8000

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Use create_tables.py instead of alembic to avoid migration conflicts
CMD ["sh", "-c", "python /app/create_tables.py && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]